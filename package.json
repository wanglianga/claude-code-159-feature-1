{
  "name": "community-medkit-share",
  "version": "1.0.0",
  "private": true,
  "description": "社区药箱共享借用归还效期提醒与邻里互助页面（Vue 3 + TypeScript + Pinia）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
